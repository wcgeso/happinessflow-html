{
  "name": "happinessflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:tasks": "GCLOUD_PROJECT=demo-happinessflow-backend FIRESTORE_EMULATOR_HOST=127.0.0.1:8482 node scripts/runEmulatorTasks.cjs",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc -p tsconfig.release.json --pretty false",
    "preview": "vite preview --configLoader runner",
    "test": "vitest --configLoader runner",
    "test:unit": "vitest --configLoader runner run --exclude 'src/test/*Permissions.test.ts'",
    "typecheck:functions": "npm --prefix functions run typecheck",
    "build:functions": "npm --prefix functions run build",
    "verify": "npm run typecheck && npm run typecheck:functions && npm run build:functions && npm run test:unit && npm run build",
    "test:rules": "firebase emulators:exec --project demo-happinessflow-backend --only firestore,database \"vitest --configLoader runner run src/test/roomPermissions.test.ts src/test/realtimePermissions.test.ts && node functions/test/rules.cjs\"",
    "test:backend": "firebase emulators:exec --project demo-happinessflow-backend --only auth,firestore,functions,database \"node functions/test/triggers.cjs\"",
    "test:backend:core": "firebase emulators:exec --project demo-happinessflow-backend --only firestore \"node scripts/testBackendCore.mjs\"",
    "test:backend:mixed": "node functions/test/build.mjs mixedTurns && firebase emulators:exec --project demo-happinessflow-backend --only firestore \"node functions/lib/mixedTurns-test.cjs\""
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.1.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vercel": "^50.1.3",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
