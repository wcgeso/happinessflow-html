rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. GM 超級權限
    // 只要是 GM 帳號，直接開放所有文件的讀寫權限
    match /{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.token.keys().hasAny(['email']) &&
        request.auth.token.email == 'gm0221@happinessflow.com';
    }
    
    // 2. 使用者資料規則
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
      );
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
        );
      }
    }
    
    // 3. 房間系統規則
    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function hasMemberList(data) {
        return data.memberUids is list;
      }

      function isHost(data) {
        return signedIn() && data.hostId == request.auth.uid;
      }

      function isCoach() {
        return signedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm'];
      }

      function isMember(data) {
        return signedIn() && (
          (hasMemberList(data) && request.auth.uid in data.memberUids) ||
          (('playerStates' in data) && data.playerStates is map && request.auth.uid in data.playerStates)
        );
      }

      function canReadRoom(data) {
        return isHost(data) ||
          (isMember(data) && (!('playerStates' in data) || data.playerStates.size() == 0)) ||
          (data.status == 'waiting' &&
            (!('playerStates' in data) || data.playerStates.size() == 0)) ||
          isCoach();
      }

      function immutableIdentity() {
        return request.resource.data.id == resource.data.id &&
          request.resource.data.hostId == resource.data.hostId;
      }

      // affectedKeys 由呼叫端傳入（最外層 allow update 只算一次 room diff 後往下
      // 傳），這裡不再自己重新對整份文件做一次 diff。
      function changedOnly(affectedKeys, fields) {
        return affectedKeys.hasOnly(fields);
      }

      function publicPlayerStates(data) {
        return ('publicPlayerStates' in data) && data.publicPlayerStates is map
          ? data.publicPlayerStates
          : {};
      }

      function joinsSelf(roomAffectedKeys) {
        return resource.data.status == 'waiting' &&
          changedOnly(roomAffectedKeys, ['members', 'memberUids']) &&
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members[request.resource.data.members.size() - 1].uid == request.auth.uid;
      }

      function leavesSelf(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['members', 'memberUids']) &&
          request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
          request.resource.data.members.size() == resource.data.members.size() - 1;
      }

      function updatesOwnPlayerState(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['playerStates']) &&
          request.resource.data.playerStates.diff(resource.data.playerStates).affectedKeys().hasOnly([request.auth.uid]);
      }

      function updatesOwnPublicPlayerState(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['publicPlayerStates']) &&
          request.resource.data.publicPlayerStates.diff(publicPlayerStates(resource.data)).affectedKeys().hasOnly([request.auth.uid]);
      }

      function submitsOwnRequest(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['pendingRequests']) &&
          request.resource.data.pendingRequests.diff(resource.data.pendingRequests).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.pendingRequests[request.auth.uid] is map &&
          request.resource.data.pendingRequests[request.auth.uid].uid == request.auth.uid &&
          request.resource.data.pendingRequests[request.auth.uid].status == 'pending';
      }

      function clearsOwnRequest(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['pendingRequests']) &&
          request.resource.data.pendingRequests.diff(resource.data.pendingRequests).affectedKeys().hasOnly([request.auth.uid]) &&
          !(request.auth.uid in request.resource.data.pendingRequests);
      }

      // roomAffectedKeys 是最外層 allow update 只算一次的
      // request.resource.data.diff(resource.data).affectedKeys()；「有哪些頂層欄位
      // 改變了」這個集合不論用哪個方向 diff 結果都一樣，直接重複使用，不必再對調
      // 方向重新 diff 一次整份文件。
      function updatesOnlyOwnPublicProjection(roomAffectedKeys) {
        return !roomAffectedKeys.hasAny(['publicPlayerStates']) ||
          (
            ('publicPlayerStates' in request.resource.data) &&
            request.resource.data.publicPlayerStates is map &&
            request.resource.data.publicPlayerStates.diff(publicPlayerStates(resource.data)).affectedKeys().hasOnly([request.auth.uid])
          );
      }

      function updatesFinancialAcceleration(roomAffectedKeys) {
        return (isHost(resource.data) || isCoach()) &&
          changedOnly(roomAffectedKeys, ['financialAcceleration']) &&
          ('financialAcceleration' in request.resource.data) &&
          request.resource.data.financialAcceleration is map &&
          (
            request.resource.data.financialAcceleration.multiplier == 1 ||
            request.resource.data.financialAcceleration.multiplier == 1.5 ||
            request.resource.data.financialAcceleration.multiplier == 2 ||
            request.resource.data.financialAcceleration.multiplier == 3
          ) &&
          request.resource.data.financialAcceleration.updatedByUid == request.auth.uid;
      }

      function previousSubsidySequence() {
        return ('financialSubsidy' in resource.data &&
          resource.data.financialSubsidy is map &&
          'sequence' in resource.data.financialSubsidy &&
          resource.data.financialSubsidy.sequence is number)
          ? resource.data.financialSubsidy.sequence
          : 0;
      }

      function updatesFinancialSubsidy(roomAffectedKeys) {
        return (isHost(resource.data) || isCoach()) &&
          changedOnly(roomAffectedKeys, ['financialSubsidy']) &&
          ('financialSubsidy' in request.resource.data) &&
          request.resource.data.financialSubsidy is map &&
          request.resource.data.financialSubsidy.amount > 0 &&
          request.resource.data.financialSubsidy.grantedByUid == request.auth.uid &&
          request.resource.data.financialSubsidy.playerUids is list &&
          request.resource.data.financialSubsidy.sequence is number &&
          request.resource.data.financialSubsidy.sequence == previousSubsidySequence() + 1;
      }

      function validPromptResponseMutation() {
        return (
          ('familyMilestoneJoinPrompt' in resource.data.boardState) &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          (
            request.resource.data.boardState.familyMilestoneJoinPrompt is map &&
              request.resource.data.boardState.familyMilestoneJoinPrompt.responses.diff(
                resource.data.boardState.familyMilestoneJoinPrompt.responses
              ).affectedKeys().hasOnly([request.auth.uid])
          )
        ) || (
          ('sharedCardPrompt' in resource.data.boardState) &&
          resource.data.boardState.sharedCardPrompt is map &&
          (
            !('sharedCardPrompt' in request.resource.data.boardState) ||
            (request.resource.data.boardState.sharedCardPrompt is map &&
              request.resource.data.boardState.sharedCardPrompt.responses.diff(
                resource.data.boardState.sharedCardPrompt.responses
              ).affectedKeys().hasOnly([request.auth.uid]))
          )
        );
      }

      function isActiveBoardEventPlayer() {
        return resource.data.boardState.get('currentEvent', null) is map &&
          resource.data.boardState.get(['currentEvent', 'playerUid'], null) == request.auth.uid &&
          request.resource.data.boardState.get('currentEvent', null) is map &&
          request.resource.data.boardState.get(['currentEvent', 'id'], null) ==
            resource.data.boardState.get(['currentEvent', 'id'], null);
      }

      function completesOwnFamilySourceEvent() {
        return resource.data.boardState.currentTurnUid == request.auth.uid &&
          resource.data.boardState.get('currentEvent', null) is map &&
          'familyMilestoneJoinPrompt' in resource.data.boardState &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourcePlayerUid == request.auth.uid &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceEventId ==
            resource.data.boardState.get(['currentEvent', 'id'], null) &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceActionCompleted == true &&
          'responses' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses is map &&
          'targetPlayerUids' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids is list &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses.keys().size() ==
            resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids.size() &&
          request.resource.data.boardState.get('familyMilestoneJoinPrompt', null) == null &&
          resource.data.boardState.get('sharedCardPrompt', null) == null;
      }

      function completesOwnFamilySourceActionAndEvent() {
        return resource.data.boardState.currentTurnUid == request.auth.uid &&
          resource.data.boardState.get('currentEvent', null) is map &&
          'familyMilestoneJoinPrompt' in resource.data.boardState &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourcePlayerUid == request.auth.uid &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceEventId ==
            resource.data.boardState.get(['currentEvent', 'id'], null) &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceActionCompleted == false &&
          'responses' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses is map &&
          'targetPlayerUids' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids is list &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses.keys().size() ==
            resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids.size() &&
          request.resource.data.boardState.get('familyMilestoneJoinPrompt', null) == null &&
          resource.data.boardState.get('sharedCardPrompt', null) == null;
      }

      function completesFamilyPromptFromParticipant() {
        return resource.data.boardState.get('currentEvent', null) is map &&
          'familyMilestoneJoinPrompt' in resource.data.boardState &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceEventId ==
            resource.data.boardState.get(['currentEvent', 'id'], null) &&
          'targetPlayerUids' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids is list &&
          request.auth.uid in resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourceActionCompleted == true &&
          'responses' in resource.data.boardState.familyMilestoneJoinPrompt &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses is map &&
          resource.data.boardState.familyMilestoneJoinPrompt.responses.keys().size() ==
            resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids.size() &&
          request.resource.data.boardState.get('familyMilestoneJoinPrompt', null) == null &&
          resource.data.boardState.get('sharedCardPrompt', null) == null;
      }

      function updatesOwnFamilySourceAction() {
        return resource.data.boardState.currentTurnUid == request.auth.uid &&
          'familyMilestoneJoinPrompt' in resource.data.boardState &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          resource.data.boardState.familyMilestoneJoinPrompt.sourcePlayerUid == request.auth.uid &&
          'familyMilestoneJoinPrompt' in request.resource.data.boardState &&
          request.resource.data.boardState.familyMilestoneJoinPrompt is map &&
          request.resource.data.boardState.familyMilestoneJoinPrompt.sourceActionCompleted == true &&
          request.resource.data.boardState.familyMilestoneJoinPrompt.diff(
            resource.data.boardState.familyMilestoneJoinPrompt
          ).affectedKeys().hasOnly(['sourceActionCompleted']);
      }

      // 注意：getAfter() 對同一個路徑重複呼叫，Firestore 規則引擎並不會自動快取，
      // 每次都要重新計入 1000 運算式預算；所以只呼叫一次，把 .data 當參數傳給
      // 下面的輔助函式重複使用（CEL 的函式參數是先求值一次再傳入，不是每次引用都
      // 重新求值），避免同一份回覆文件被讀取 4 次。
      function hasOwnSubcollectionResponseAfter(promptData) {
        return promptData is map &&
          'id' in promptData &&
          promptData.id is string &&
          'responseStorage' in promptData &&
          promptData.responseStorage == 'subcollection' &&
          promptData.targetPlayerUids is list &&
          request.auth.uid in promptData.targetPlayerUids &&
          existsAfter(/databases/$(database)/documents/rooms/$(roomId)/events/$(promptData.id)/responses/$(request.auth.uid)) &&
          matchesOwnSubcollectionResponse(promptData,
            getAfter(/databases/$(database)/documents/rooms/$(roomId)/events/$(promptData.id)/responses/$(request.auth.uid)).data);
      }

      function matchesOwnSubcollectionResponse(promptData, responseData) {
        return responseData.promptId == promptData.id &&
          responseData.playerUid == request.auth.uid &&
          responseData.commandId is string &&
          request.resource.data.boardState.processedCommandIds is list &&
          request.resource.data.boardState.processedCommandIds.hasAny([responseData.commandId]) &&
          resource.data.boardState.processedCommandIds is list &&
          !resource.data.boardState.processedCommandIds.hasAny([responseData.commandId]);
      }

      function respondsToOwnSubcollectionPrompt() {
        return (('familyMilestoneJoinPrompt' in resource.data.boardState) &&
            hasOwnSubcollectionResponseAfter(resource.data.boardState.familyMilestoneJoinPrompt)) ||
          (('sharedCardPrompt' in resource.data.boardState) &&
            hasOwnSubcollectionResponseAfter(resource.data.boardState.sharedCardPrompt));
      }

      function validBoardCommand(roomAffectedKeys) {
        return isMember(resource.data) &&
          (
            (resource.data.boardState.currentTurnUid == request.auth.uid &&
              (!('familyMilestoneJoinPrompt' in resource.data.boardState) || resource.data.boardState.familyMilestoneJoinPrompt == null) &&
              (!('sharedCardPrompt' in resource.data.boardState) || resource.data.boardState.sharedCardPrompt == null)) ||
            completesOwnFamilySourceEvent() ||
            completesOwnFamilySourceActionAndEvent() ||
            completesFamilyPromptFromParticipant() ||
            updatesOwnFamilySourceAction() ||
            (('familyMilestoneJoinPrompt' in resource.data.boardState) &&
              resource.data.boardState.familyMilestoneJoinPrompt is map &&
              request.auth.uid in resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids &&
              validPromptResponseMutation()) ||
            (('sharedCardPrompt' in resource.data.boardState) &&
              resource.data.boardState.sharedCardPrompt is map &&
              request.auth.uid in resource.data.boardState.sharedCardPrompt.targetPlayerUids &&
              validPromptResponseMutation()) ||
            respondsToOwnSubcollectionPrompt()
          ) &&
          changedOnly(roomAffectedKeys, ['boardState', 'publicPlayerStates', 'marketPrices', 'previousMarketPrices', 'marketUpdates']) &&
          request.resource.data.boardState.revision == resource.data.boardState.revision + 1 &&
          request.resource.data.boardState.processedCommandIds is list &&
          request.resource.data.boardState.processedCommandIds.size() <= 100 &&
          request.resource.data.boardState.processedCommandIds != resource.data.boardState.processedCommandIds &&
          updatesOnlyOwnPublicProjection(roomAffectedKeys);
      }

      // roomAffectedKeys／boardStateAffectedKeys 都是 validBoardStateUpdateForPlayer()
      // 只算一次、往下傳進來的結果，這裡不再各自重新對整份文件或整個 boardState
      // 做一次 diff。
      function updatesRealEstateMarketPurchase(roomAffectedKeys, boardStateAffectedKeys) {
        return signedIn() &&
          resource.data.status == 'playing' &&
          hasMemberList(resource.data) &&
          request.auth.uid in resource.data.memberUids &&
          roomAffectedKeys.hasOnly(['boardState', 'publicPlayerStates']) &&
          resource.data.boardState.realEstateMarket is list &&
          request.resource.data.boardState.realEstateMarket is list &&
          boardStateAffectedKeys.hasOnly(['realEstateMarket', 'revision', 'processedCommandIds', 'updatedAt']) &&
          request.resource.data.boardState.realEstateMarket.size() == resource.data.boardState.realEstateMarket.size() - 1 &&
          resource.data.boardState.realEstateMarket.hasAll(request.resource.data.boardState.realEstateMarket) &&
          request.resource.data.boardState.revision == resource.data.boardState.revision + 1 &&
          request.resource.data.boardState.processedCommandIds is list &&
          request.resource.data.boardState.processedCommandIds.size() <= 100 &&
          request.resource.data.boardState.processedCommandIds != resource.data.boardState.processedCommandIds &&
          (
            (resource.data.boardState.processedCommandIds.size() < 100 &&
              request.resource.data.boardState.processedCommandIds.size() == resource.data.boardState.processedCommandIds.size() + 1) ||
            (resource.data.boardState.processedCommandIds.size() == 100 &&
              request.resource.data.boardState.processedCommandIds.size() == 100)
          ) &&
          updatesOnlyOwnPublicProjection(roomAffectedKeys);
      }

      function updatesBoardNoticeOnly(roomAffectedKeys, boardStateAffectedKeys) {
        return isMember(resource.data) &&
          resource.data.boardState.currentTurnUid == request.auth.uid &&
          changedOnly(roomAffectedKeys, ['boardState']) &&
          boardStateAffectedKeys.hasOnly(['realEstateMarket', 'updatedAt']);
      }

      function updatesOwnBoardPromptResponse(roomAffectedKeys) {
        return isMember(resource.data) &&
          changedOnly(roomAffectedKeys, ['boardState', 'publicPlayerStates']) &&
          request.resource.data.boardState.revision == resource.data.boardState.revision + 1 &&
          request.resource.data.boardState.processedCommandIds is list &&
          request.resource.data.boardState.processedCommandIds != resource.data.boardState.processedCommandIds &&
          (
            (('familyMilestoneJoinPrompt' in resource.data.boardState) &&
              resource.data.boardState.familyMilestoneJoinPrompt is map &&
              request.resource.data.boardState.familyMilestoneJoinPrompt is map &&
              request.resource.data.boardState.familyMilestoneJoinPrompt.responses.diff(
                resource.data.boardState.familyMilestoneJoinPrompt.responses
              ).affectedKeys().hasOnly([request.auth.uid])) ||
            (('sharedCardPrompt' in resource.data.boardState) &&
              resource.data.boardState.sharedCardPrompt is map &&
              request.resource.data.boardState.sharedCardPrompt is map &&
              request.resource.data.boardState.sharedCardPrompt.responses.diff(
                resource.data.boardState.sharedCardPrompt.responses
              ).affectedKeys().hasOnly([request.auth.uid]))
          ) &&
          updatesOnlyOwnPublicProjection(roomAffectedKeys);
      }

      function skipsDisconnectedTurn(roomAffectedKeys, boardStateAffectedKeys) {
        return isCoach() &&
          changedOnly(roomAffectedKeys, ['boardState']) &&
          request.resource.data.boardState.currentTurnUid != resource.data.boardState.currentTurnUid &&
          request.resource.data.boardState.currentTurnUid in resource.data.boardState.turnOrder &&
          request.resource.data.boardState.hasRolledThisTurn == false &&
          (!('currentEvent' in resource.data.boardState) || resource.data.boardState.currentEvent == null) &&
          (!('pendingEvents' in resource.data.boardState) || resource.data.boardState.pendingEvents.size() == 0) &&
          (!('movement' in resource.data.boardState) || resource.data.boardState.movement == null) &&
          (!('familyMilestoneJoinPrompt' in resource.data.boardState) || resource.data.boardState.familyMilestoneJoinPrompt == null) &&
          (!('sharedCardPrompt' in resource.data.boardState) || resource.data.boardState.sharedCardPrompt == null) &&
          boardStateAffectedKeys.hasOnly(['currentTurnUid', 'hasRolledThisTurn', 'skipTurns', 'revision', 'processedCommandIds', 'updatedAt']) &&
          request.resource.data.boardState.revision == resource.data.boardState.revision + 1 &&
          request.resource.data.boardState.processedCommandIds is list &&
          request.resource.data.boardState.processedCommandIds.size() <= 100 &&
          request.resource.data.boardState.processedCommandIds != resource.data.boardState.processedCommandIds;
      }

      function hostUpdateAllowed() {
        return isHost(resource.data) && (
          (!('financialSubsidy' in resource.data) && !('financialSubsidy' in request.resource.data)) ||
          (('financialSubsidy' in resource.data) &&
            ('financialSubsidy' in request.resource.data) &&
            request.resource.data.financialSubsidy == resource.data.financialSubsidy)
        );
      }

      // 玩家經過銀行後會拿到「銀行服務窗口」，可以在之後其他玩家的回合購買股票／
      // 保險／定存／汽車、辦信貸或還款，直到自己下一次擲骰才關閉（見
      // RoomContext.tsx 的 bankServiceWindowActive，一律寫在私有玩家文件裡）。
      function isBankServiceWindowOpenForMe() {
        return signedIn() &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data.bankServiceWindowActive == true;
      }

      // 有一張共享／家庭歷程卡片目前正在等自己回覆時，才需要先處理它，不能被銀行
      // 服務窗口繞過；跟自己無關的卡片（沒有把自己列進 targetPlayerUids）不受影響。
      function isTargetOfBlockingPrompt() {
        return (
          ('familyMilestoneJoinPrompt' in resource.data.boardState) &&
          resource.data.boardState.familyMilestoneJoinPrompt is map &&
          request.auth.uid in resource.data.boardState.familyMilestoneJoinPrompt.targetPlayerUids
        ) || (
          ('sharedCardPrompt' in resource.data.boardState) &&
          resource.data.boardState.sharedCardPrompt is map &&
          request.auth.uid in resource.data.boardState.sharedCardPrompt.targetPlayerUids
        );
      }

      // 這類指令（股票／保險／定存／汽車／信貸／還款）只會寫回自己的私有玩家文件，
      // 房間文件只帶動 revision／processedCommandIds／updatedAt，不觸碰任何棋盤事件
      // 或其他玩家的資料，因此允許不是目前回合時也能提交。
      //
      // 先做完全不用讀取文件的便宜檢查（傳入的 boardStateAffectedKeys），只有在
      // 欄位範圍真的符合銀行服務窗口指令時，才繼續付出 get()/exists() 的成本；CEL
      // 的 || / && 只保證「可交換」、不保證一定由左到右求值，所以不能只靠把這個
      // 分支放在 OR 鏈最後面來省成本，必須讓分支本身在不適用時就用便宜條件提早
      // 判否。
      function usesOwnBankServiceWindow(boardStateAffectedKeys) {
        return boardStateAffectedKeys.hasOnly(['revision', 'processedCommandIds', 'updatedAt']) &&
          isMember(resource.data) &&
          isBankServiceWindowOpenForMe() &&
          !isTargetOfBlockingPrompt();
      }

      // hostUpdateAllowed() 刻意留在 boardState diff 之前：執行師的動作完全用不到
      // 這個 diff，這樣執行師操作就不用白付一次 boardState diff 的成本。其餘玩家
      // 動作才需要共用同一份 boardState diff，所以移到
      // validBoardStateUpdateForPlayer() 用 let 只算一次，傳給下面幾個函式共用。
      function validBoardStateUpdate(roomAffectedKeys) {
        return hostUpdateAllowed()
          ? (changesActiveMovement() ? validBoardStateUpdateForPlayer(roomAffectedKeys) : true)
          : validBoardStateUpdateForPlayer(roomAffectedKeys);
      }

      // Active movement transitions cannot fall through the general turn-owner grant.
      function changesActiveMovement() {
        return resource.data.boardState.get('movement', null) is map &&
          resource.data.boardState.movement.isActive == true &&
          (request.resource.data.boardState.get('movement', null) != resource.data.boardState.movement ||
            request.resource.data.boardState.playerPositions != resource.data.boardState.playerPositions);
      }

      function validSettledMovement(movement, nextMovement) {
        return movement.get('remainingPath', []).size() == 0
          ? nextMovement == null
          : nextMovement is map && nextMovement.isActive == false &&
            nextMovement.path == movement.remainingPath &&
            nextMovement.get('remainingPath', []).size() == 0 &&
            nextMovement.diff(movement).affectedKeys().hasOnly(['isActive', 'path', 'remainingPath']);
      }

      function validMovementLanding(movement, nextBoard) {
        let landing = movement.path[movement.path.size() - 1];
        let event = nextBoard.currentEvent;
        let cardSquare = !(landing in [0, 6, 13, 15, 24, 26, 27, 32, 39, 41, 50]);
        let eventId = movement.playerUid + '_' + string(movement.startedAt) + '_';
        return nextBoard.playerPositions.diff(resource.data.boardState.playerPositions).affectedKeys().hasOnly([movement.playerUid]) &&
          nextBoard.playerPositions[movement.playerUid] == landing &&
          event is map && event.playerUid == movement.playerUid &&
          event.squareIndex == landing && event.rollTotal == movement.rollTotal &&
          ((landing in [6, 15, 24, 32, 41, 50] && event.type == 'bank' &&
              (event.id == eventId + 'bank' || event.id == eventId + 'bank_land')) ||
          (landing in [0, 26] && event.type == 'school' &&
              (event.id == eventId + 'school' || event.id == eventId + 'school_land')) ||
            (landing == 27 && event.type == 'repair' &&
              event.id == eventId + 'repair') ||
            (landing in [13, 39] && event.type == 'hospital' && event.id == eventId + 'hospital') ||
            (cardSquare && event.type == 'card' &&
              (event.id == eventId + 'happiness' || event.id == eventId + 'news' || event.id == eventId + 'opportunity'))) &&
          (cardSquare
            ? nextBoard.currentCard is map && nextBoard.currentCardReveal is map &&
              nextBoard.currentCardReveal.eventId == event.id &&
              nextBoard.currentCardReveal.cardId == nextBoard.currentCard.cardId &&
              nextBoard.currentCardReveal.isRevealed == false
            : nextBoard.get('currentCard', null) == null && nextBoard.get('currentCardReveal', null) == null &&
              nextBoard.get('deckState', resource.data.boardState.get('deckState', null)) == resource.data.boardState.get('deckState', null) &&
              nextBoard.get('cardLog', resource.data.boardState.get('cardLog', null)) == resource.data.boardState.get('cardLog', null)) &&
          nextBoard.pendingEvents.size() == 0 &&
          validSettledMovement(movement, nextBoard.get('movement', null));
      }

      function validMovementSettlement(roomKeys, boardKeys) {
        let movement = resource.data.boardState.movement;
        let nextBoard = request.resource.data.boardState;
        let command = 'movement:' + movement.playerUid + ':' + string(movement.startedAt) + ':settle';
        return (isHost(resource.data) || (isMember(resource.data) && movement.playerUid == request.auth.uid)) && resource.data.status == 'playing' &&
          resource.data.boardState.currentTurnUid == movement.playerUid &&
          movement.path.size() > 0 &&
          request.time.toMillis() >= movement.startedAt + movement.introDelayMs +
            movement.path.size() * movement.stepDurationMs + movement.landingDelayMs + (isHost(resource.data) ? 0 : 2000) &&
          roomKeys.hasOnly(['boardState', 'publicPlayerStates']) &&
          boardKeys.hasOnly(['movement', 'playerPositions', 'currentEvent', 'currentCard', 'currentCardReveal',
            'pendingEvents', 'deckState', 'cardLog', 'revision', 'processedCommandIds', 'updatedAt']) &&
          nextBoard.revision == resource.data.boardState.revision + 1 &&
          nextBoard.processedCommandIds.size() <= 100 &&
          !(command in resource.data.boardState.processedCommandIds) && command in nextBoard.processedCommandIds &&
          (!roomKeys.hasAny(['publicPlayerStates']) || request.resource.data.publicPlayerStates.diff(resource.data.publicPlayerStates).affectedKeys().hasOnly([movement.playerUid])) &&
          validMovementLanding(movement, nextBoard);
      }

      function validBoardStateUpdateForPlayer(roomAffectedKeys) {
        let boardStateAffectedKeys = request.resource.data.boardState.diff(resource.data.boardState).affectedKeys();
        return changesActiveMovement() ? validMovementSettlement(roomAffectedKeys, boardStateAffectedKeys) : (validBoardCommand(roomAffectedKeys) ||
          updatesRealEstateMarketPurchase(roomAffectedKeys, boardStateAffectedKeys) ||
          skipsDisconnectedTurn(roomAffectedKeys, boardStateAffectedKeys) ||
          updatesBoardNoticeOnly(roomAffectedKeys, boardStateAffectedKeys) ||
          updatesOwnBoardPromptResponse(roomAffectedKeys) ||
          usesOwnBankServiceWindow(boardStateAffectedKeys));
      }

      function validNonBoardUpdate(roomAffectedKeys) {
        return hostUpdateAllowed() ||
          joinsSelf(roomAffectedKeys) ||
          leavesSelf(roomAffectedKeys) ||
          updatesOwnPlayerState(roomAffectedKeys) ||
          updatesOwnPublicPlayerState(roomAffectedKeys) ||
          updatesFinancialAcceleration(roomAffectedKeys) ||
          updatesFinancialSubsidy(roomAffectedKeys) ||
          submitsOwnRequest(roomAffectedKeys) ||
          clearsOwnRequest(roomAffectedKeys);
      }

      allow create: if signedIn() &&
        request.resource.data.id == roomId &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.memberUids == [request.auth.uid] &&
        (!('playerStates' in request.resource.data) || request.resource.data.playerStates.size() == 0);

      // Transitional note: members still read the legacy Room document. Full private
      // projection separation requires the subcollection migration before this becomes
      // host/public-only.
      // 允許已登入使用者確認房號不存在；不存在的文件不會暴露任何資料。
      allow read: if signedIn() &&
        (!exists(/databases/$(database)/documents/rooms/$(roomId)) || canReadRoom(resource.data));

      // roomAffectedKeys 只算一次 request.resource.data.diff(resource.data).
      // affectedKeys()，用它決定走 board 還是 non-board 分支，並傳給兩邊所有驗證
      // 函式重複使用；不再讓十幾個函式各自對整份文件重新做一次 diff。
      // 注意：allow ...: if 後面只接受一個條件式，不能直接寫 let；let 只能出現在
      // function 內部，所以把整條判斷包成一個函式再讓 allow 呼叫它。
      function validLearningPayment(before, after, fee) {
        let oldDebt = before.get('liabilities', []);
        let newDebt = after.get('liabilities', []);
        let shortfall = fee > before.cash ? fee - before.cash : 0;
        let added = newDebt.size() > oldDebt.size() ? newDebt[oldDebt.size()] : {};
        return after.cash == before.cash - fee ||
          (shortfall > 0 && after.cash == 0 && newDebt.size() == oldDebt.size() + 1 &&
            newDebt == oldDebt.concat([added]) && added.get('totalOwed', 0) == shortfall &&
            added.get('id', '') is string && added.get('id', '').size() > 0 &&
            ((added.get('type', '') == '信用貸款' && added.get('monthlyPayment', -1) == int(shortfall * 0.1)) ||
              (added.get('type', '') == '強制負債' && added.get('monthlyPayment', -1) == 0)));
      }

      function validNewLearningContinuation(next) {
        let board = resource.data.boardState;
        let oldPlayer = get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data;
        let newPlayer = getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data;
        let profession = next.cardId in ['C001', 'C002', 'C003', 'C004'];
        let stock = next.cardId in ['C005', 'C006'];
        let fee = next.cardId in ['C005', 'C006', 'C008'] ? 10000 : 5000;
        return next.kind == 'lifelong-learning' && next.phase == 'awaiting_roll' &&
          next.playerUid == request.auth.uid && board.currentTurnUid == request.auth.uid &&
          next.sessionId == resource.data.sessionId && next.sourceEventId == board.currentEvent.id &&
          next.cardId == board.currentCard.cardId && next.cardId in ['C001','C002','C003','C004','C005','C006','C007','C008'] &&
          next.commandId is string && next.createdAt is number &&
          next.learningType == (profession ? 'enhance_profession' : (stock ? 'stock_ability' : 'real_estate_ability')) &&
          next.requiredRoll == (profession ? 2 : 4) &&
          request.resource.data.boardState.currentEvent == board.currentEvent &&
          request.resource.data.boardState.currentCard == board.currentCard &&
          validLearningPayment(oldPlayer, newPlayer, fee);
      }

      function validNewDrawContinuation(next) {
        let board = resource.data.boardState;
        return (isHost(resource.data) || isCoach()) && next.kind == 'followup-card' &&
          next.phase == 'awaiting_draw' && next.deck == 'news' && next.cardId == 'C056' &&
          next.sessionId == resource.data.sessionId && next.sourceEventId == board.currentEvent.id &&
          next.playerUid == board.currentEvent.playerUid && board.currentCard.cardId == next.cardId &&
          next.commandId == 'draw-followup:' + next.sourceEventId + ':news' && next.createdAt is number;
      }

      function validCompletedContinuation(previous, next) {
        let nextBoard = request.resource.data.boardState;
        return previous.playerUid == request.auth.uid && resource.data.boardState.currentTurnUid == request.auth.uid &&
          previous.sessionId == resource.data.sessionId && previous.phase in ['awaiting_roll','awaiting_draw'] &&
          next.phase == 'completed' && next.diff(previous).affectedKeys().hasOnly(['phase','result']) &&
          (previous.kind == 'lifelong-learning'
            ? next.result.roll is int && next.result.roll >= 1 && next.result.roll <= 6 &&
              next.result.target == previous.requiredRoll && next.result.success == (next.result.roll >= next.result.target) &&
              nextBoard.currentEvent.id == previous.sourceEventId && nextBoard.currentCard.cardId == previous.cardId
            : next.result.eventId == nextBoard.currentEvent.id && next.result.cardId == nextBoard.currentCard.cardId &&
              nextBoard.currentEvent.playerUid == previous.playerUid && nextBoard.currentCard.deck == previous.deck);
      }

      function validContinuationTransition() {
        let previous = resource.data.boardState.get('pendingContinuation', null);
        let next = request.resource.data.boardState.get('pendingContinuation', null);
        return previous == next
          ? (previous == null || previous.phase == 'completed' ||
              request.resource.data.boardState.currentEvent == resource.data.boardState.currentEvent)
          : (previous == null
            ? next is map && (validNewDrawContinuation(next) || validNewLearningContinuation(next))
            : next == null
              ? previous.phase == 'completed'
              : next is map && validCompletedContinuation(previous, next));
      }

      function isValidRoomUpdate() {
        let roomAffectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return signedIn() && immutableIdentity() && (
          roomAffectedKeys.hasAny(['boardState'])
            ? (validContinuationTransition() && validBoardStateUpdate(roomAffectedKeys))
            : validNonBoardUpdate(roomAffectedKeys)
        );
      }

      allow update: if isValidRoomUpdate();

      allow delete: if isHost(resource.data);

      match /players/{playerUid} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function isRoomMember() {
          return signedIn() && (
            (roomData().memberUids is list && request.auth.uid in roomData().memberUids) ||
            (('playerStates' in roomData()) && roomData().playerStates is map && request.auth.uid in roomData().playerStates)
          );
        }

        function isRoomCoach() {
          return signedIn() && ((exists(/databases/$(database)/documents/rooms/$(roomId)) && roomData().hostId == request.auth.uid) || isCoach());
        }

        function canReadOwnWaitingState() {
          return signedIn() && request.auth.uid == playerUid &&
            (isRoomMember() || roomData().status == 'waiting');
        }

        allow read: if canReadOwnWaitingState() || isRoomCoach();
        function isCompletingMovement() {
          let before = roomData().get('boardState', {});
          let after = getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.get('boardState', {});
          return before.get('movement', null) is map && before.movement.isActive == true &&
            after.get('movement', null) != before.movement;
        }
        function validMovementPlayerWrite() {
          let before = roomData().get('boardState', {});
          let after = getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.get('boardState', {});
          return before.get('movement', null) is map && before.movement.isActive == true &&
            after.get('movement', null) != before.movement
            ? (before.movement.playerUid == playerUid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'boardPosition', 'skipTurns', 'lastBoardEvent', 'pendingCardAction',
                'bankServiceWindowActive', 'bankServiceGrantedAtEventId']) &&
              request.resource.data.boardPosition == before.movement.path[before.movement.path.size() - 1] &&
              request.resource.data.get('skipTurns', 0) == resource.data.get('skipTurns', 0) &&
              (request.resource.data.get('bankServiceWindowActive', false) == resource.data.get('bankServiceWindowActive', false) ||
                (after.get('currentEvent', null) is map && after.currentEvent.type == 'bank' && after.currentEvent.squareIndex in [6, 15, 24, 32, 41, 50] &&
                  request.resource.data.get('bankServiceWindowActive', false) == true &&
                  request.resource.data.get('bankServiceGrantedAtEventId', '') == after.currentEvent.id)))
            : true;
        }
        function validFinancialCommit() {
          let financialChanged=request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'cash','assets','liabilities','expenses','income','happiness','happinessTotal','profession','abilities','medicalInsuranceCount','history','marketPrices','previousMarketPrices','lastMarketUpdateTimestamp','lastPublicEffectTimestamp','lastPublicEffectId']);
          let command=request.resource.data.get('lastFinancialCommandId','');
          // Receipt IDs are URI encoded by the client; the document path is carried explicitly below.
          return roomData().get('financialHistoryStorage','') != 'subcollection' || !resource.data.get('isSetup',false) || !financialChanged ||
            (command is string && command.size()>0 && command is string &&
              !exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerUid)/commandResults/$(command)) &&
              getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerUid)/commandResults/$(command)).data.commandId == command);
        }

        allow create: if ((isRoomMember() && request.auth.uid == playerUid) || isRoomCoach()) && !isCompletingMovement();
        allow update: if ((isRoomMember() && request.auth.uid == playerUid) || isRoomCoach())
          ? (validMovementPlayerWrite() && validFinancialCommit())
          : false;
        allow delete: if isRoomCoach();

        match /transactions/{transactionId} {
          allow read: if signedIn() && (request.auth.uid==playerUid || isRoomCoach() || isCoach());
          allow create: if ((isRoomMember() && request.auth.uid==playerUid) || isRoomCoach()) &&
            roomData().get('financialHistoryStorage','')=='subcollection' && request.resource.data.sessionId==roomData().sessionId &&
            request.resource.data.playerUid==playerUid && request.resource.data.id is string && request.resource.data.timestamp is number;
          allow update, delete: if false;
        }
        match /commandResults/{commandId} {
          allow read: if signedIn() && (request.auth.uid==playerUid || isRoomCoach() || isCoach());
          allow create: if ((isRoomMember() && request.auth.uid==playerUid) || isRoomCoach()) &&
            roomData().get('financialHistoryStorage','')=='subcollection' && request.resource.data.sessionId==roomData().sessionId &&
            request.resource.data.playerUid==playerUid && request.resource.data.commandId==commandId && request.resource.data.status=='applied';
          allow update, delete: if false;
        }

      }

      match /coachCommands/{commandId} {
        function roomData() {return get(/databases/$(database)/documents/rooms/$(roomId)).data;}
        allow read: if signedIn() && (isCoach() || isHost(roomData()));
        allow create: if signedIn() && (isHost(roomData()) || isCoach()) && roomData().status=='playing' &&
          roomData().get('flowSchemaVersion',0)==1 && request.resource.data.sessionId==roomData().sessionId &&
          request.resource.data.coachUid==request.auth.uid && request.resource.data.kind=='subsidy' &&
          request.resource.data.commandId is string && request.resource.data.commandId.size()>0 &&
          request.resource.data.result==getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.financialSubsidy;
        allow update, delete: if false;
      }

      match /financialEffects/{effectId} {
        function roomData() {return get(/databases/$(database)/documents/rooms/$(roomId)).data;}
        function afterRoom() {return getAfter(/databases/$(database)/documents/rooms/$(roomId)).data;}
        allow read: if signedIn() && (isMember(roomData()) || isHost(roomData()) || isCoach());
        allow create: if signedIn() && roomData().status=='playing' && roomData().get('flowSchemaVersion',0)==1 &&
          request.resource.data.sessionId==roomData().sessionId && request.resource.data.sourcePlayerUid==request.auth.uid &&
          (request.resource.data.kind=='market'
            ? (roomData().boardState.currentTurnUid==request.auth.uid || isHost(roomData()) || isCoach()) &&
              request.resource.data.payload==afterRoom().marketUpdates &&
              afterRoom().marketUpdates!=roomData().get('marketUpdates',null)
            : request.resource.data.kind=='expense' && roomData().boardState.currentTurnUid==request.auth.uid &&
              request.resource.data.payload==afterRoom().boardState.sharedExpenseEffect);
        allow update, delete: if false;
      }

      match /presence/{presenceUid} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function isRoomMember() {
          return signedIn() && (
            (roomData().memberUids is list && request.auth.uid in roomData().memberUids) ||
            (('playerStates' in roomData()) && roomData().playerStates is map && request.auth.uid in roomData().playerStates)
          );
        }

        function isRoomCoach() {
          return signedIn() && (
            roomData().hostId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm'])
          );
        }

        function validPresence() {
          return request.resource.data.uid == presenceUid &&
            request.resource.data.status in ['online', 'offline'] &&
            request.resource.data.sessionId is string &&
            request.resource.data.lastSeenAt is timestamp;
        }

        allow read: if isRoomMember();
        allow create: if isRoomMember() && request.auth.uid == presenceUid && validPresence();
        allow update: if isRoomMember() && request.auth.uid == presenceUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'status', 'sessionId', 'lastSeenAt']) &&
          validPresence();
        allow delete: if isRoomCoach() || (isRoomMember() && request.auth.uid == presenceUid);
      }

      match /diagnostics/{diagnosticUid} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function isRoomMember() {
          return signedIn() && (
            (roomData().memberUids is list && request.auth.uid in roomData().memberUids) ||
            (('playerStates' in roomData()) && roomData().playerStates is map && request.auth.uid in roomData().playerStates)
          );
        }

        function isRoomCoach() {
          return signedIn() && (
            roomData().hostId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm'])
          );
        }

        function validDiagnostic() {
          return request.resource.data.keys().hasOnly([
              'uid', 'sessionId', 'flow', 'screen', 'activeModal', 'boardEventId',
              'cardId', 'pendingAction', 'errorMessage', 'errorAt', 'updatedAt',
              'clientId', 'appVersion', 'records', 'subscriptions', 'controller', 'clock', 'buildId', 'rulesHash'
            ]) &&
            (diagnosticUid == request.resource.data.uid || diagnosticUid == request.resource.data.uid + '_' + request.resource.data.get('clientId', '')) &&
            request.resource.data.sessionId is string &&
            request.resource.data.flow is string &&
            request.resource.data.screen is string &&
            request.resource.data.updatedAt is timestamp &&
            request.resource.data.get('records', []) is list && request.resource.data.get('records', []).size() <= 20 &&
            request.resource.data.get('subscriptions', []) is list && request.resource.data.get('subscriptions', []).size() <= 20 &&
            (!('activeModal' in request.resource.data) || request.resource.data.activeModal == null || request.resource.data.activeModal is string) &&
            (!('boardEventId' in request.resource.data) || request.resource.data.boardEventId == null || request.resource.data.boardEventId is string) &&
            (!('cardId' in request.resource.data) || request.resource.data.cardId == null || request.resource.data.cardId is string) &&
            (!('pendingAction' in request.resource.data) || request.resource.data.pendingAction == null || request.resource.data.pendingAction is string) &&
            (!('errorMessage' in request.resource.data) || request.resource.data.errorMessage == null || request.resource.data.errorMessage is string) &&
            (!('errorAt' in request.resource.data) || request.resource.data.errorAt == null || request.resource.data.errorAt is number);
        }

        allow read: if isRoomCoach();
        allow create: if isRoomMember() && request.auth.uid == request.resource.data.uid && validDiagnostic();
        allow update: if isRoomMember() && request.auth.uid == resource.data.uid && request.auth.uid == request.resource.data.uid && validDiagnostic();
        allow delete: if isRoomCoach() || (isRoomMember() && request.auth.uid == diagnosticUid);
      }

      match /pendingRequests/{requestId} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function isRoomMember() {
          return signedIn() && (
            (roomData().memberUids is list && request.auth.uid in roomData().memberUids) ||
            (('playerStates' in roomData()) && roomData().playerStates is map && request.auth.uid in roomData().playerStates)
          );
        }

        function isRoomCoach() {
          return signedIn() && (
            roomData().hostId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm'])
          );
        }

        function validRequest() {
          return request.resource.data.keys().hasOnly([
              'id', 'uid', 'playerName', 'type', 'amount', 'timestamp', 'status',
              'insuranceType', 'happinessLabel', 'promotionType', 'boardCardId',
              'shareLabel', 'boardEventId', 'familyStageProgressId', 'sessionId'
            ]) &&
            request.resource.data.id == requestId &&
            request.resource.data.uid is string &&
            request.resource.data.playerName is string &&
            request.resource.data.type in ['payday', 'insurance', 'happiness', 'promotion', 'lifelong', 'board_share', 'family_milestone'] &&
            request.resource.data.amount is number &&
            request.resource.data.timestamp is number &&
            request.resource.data.status in ['pending', 'approved', 'rejected'] &&
            request.resource.data.sessionId is string &&
            request.resource.data.sessionId == roomData().sessionId;
        }

        allow read: if isRoomCoach() || (isRoomMember() && resource.data.uid == request.auth.uid);
        allow create: if isRoomMember() &&
          request.auth.uid == request.resource.data.uid &&
          validRequest() &&
          request.resource.data.status == 'pending';
        allow update: if isRoomCoach() &&
          validRequest() &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.sessionId == resource.data.sessionId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['approved', 'rejected'];
        allow delete: if signedIn() && (
          !exists(/databases/$(database)/documents/rooms/$(roomId)/pendingRequests/$(requestId))
            ? true
            : isRoomCoach() || (isRoomMember() && resource.data.uid == request.auth.uid)
        );
      }

      match /events/{eventId} {
        // room 由呼叫端透過 let 只讀一次房間文件後傳入；這個 match 底下（含巢狀的
        // responses）原本每個輔助函式都各自呼叫 roomData()／get()，同一次規則求值
        // 裡光是 allow create 就可能重複讀好幾十次同一份房間文件，容易撞上
        // Firestore 每次請求 1000 個運算式的硬上限，多人同時回覆時尤其明顯。
        function isRoomMember(room) {
          return signedIn() && (
            (room.memberUids is list && request.auth.uid in room.memberUids) ||
            (('playerStates' in room) && room.playerStates is map && request.auth.uid in room.playerStates)
          );
        }

        // 非房主玩家若沒有 users/{uid} 文件，get().data 會直接拋錯；且這次把
        // isRoomCoach() 的結果透過 let 提前算好重複使用，CEL 的 || 原本可以在其他
        // 分支已經為真時跳過這裡不理會這個錯誤，一旦提前求值就沒有這個保護，一定
        // 要先用 exists() 檔掉才安全。
        function isRoomCoach(room) {
          return signedIn() && (
            room.hostId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm'])
          );
        }

        function validEvent() {
          return request.resource.data.keys().hasOnly([
              'roomId', 'sessionId', 'commandType', 'revision', 'result', 'recordedAt'
            ]) &&
            request.resource.data.roomId == roomId &&
            request.resource.data.sessionId is string &&
            request.resource.data.commandType is string &&
            request.resource.data.revision is number &&
            request.resource.data.result == 'committed';
        }

        function canReadOrDeleteEvent() {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return isRoomCoach(room);
        }

        function canWriteEvent() {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return isRoomMember(room) && validEvent();
        }

        allow read: if canReadOrDeleteEvent();
        allow create, update: if canWriteEvent();
        allow delete: if canReadOrDeleteEvent();

        match /responses/{responseUid} {
          // 欄位不存在時直接用點記法存取會讓規則求值直接拋錯（跟用 'x' in map
          // 先檢查、再取值不同），兩張提示卡通常不會同時存在，缺欄位要安全回傳
          // null，讓呼叫端的 `is map` 判斷正常得到 false，而不是整條規則評估失敗。
          function sharedPrompt(room) {
            return ('sharedCardPrompt' in room.boardState) ? room.boardState.sharedCardPrompt : null;
          }

          function familyPrompt(room) {
            return ('familyMilestoneJoinPrompt' in room.boardState) ? room.boardState.familyMilestoneJoinPrompt : null;
          }

          function isSharedPromptTarget(room) {
            let target = sharedPrompt(room);
            return room.status == 'playing' && isRoomMember(room) &&
              target is map &&
              (!('sourceEventId' in target) ||
                (room.boardState.get('currentEvent', null) is map &&
                  room.boardState.get(['currentEvent', 'id'], null) == target.sourceEventId)) &&
              target.id == eventId &&
              'responseStorage' in target &&
              target.responseStorage == 'subcollection' &&
              target.targetPlayerUids is list &&
              responseUid == request.auth.uid &&
              responseUid in target.targetPlayerUids;
          }

          function isFamilyPromptTarget(room) {
            let target = familyPrompt(room);
            return room.status == 'playing' &&
              isRoomMember(room) &&
              target is map &&
              target.id == eventId &&
              'sourceEventId' in target &&
              'responseStorage' in target &&
              target.responseStorage == 'subcollection' &&
              'targetPlayerUids' in target &&
              target.targetPlayerUids is list &&
              room.boardState.get('currentEvent', null) is map &&
              room.boardState.get(['currentEvent', 'id'], null) == target.sourceEventId &&
              responseUid == request.auth.uid &&
              responseUid in target.targetPlayerUids;
          }

          function validSharedResponse() {
            return request.resource.data.keys().hasOnly([
                'promptId', 'playerUid', 'playerName', 'status', 'amount',
                'selectedAssetIds', 'note', 'respondedAt', 'commandId'
              ]) &&
              request.resource.data.promptId == eventId &&
              request.resource.data.playerUid == responseUid &&
              request.resource.data.playerName is string &&
              request.resource.data.status in ['completed', 'declined', 'no_effect'] &&
              request.resource.data.respondedAt is number &&
              request.resource.data.commandId is string;
          }

          function validFamilyResponse() {
            return request.resource.data.keys().hasOnly([
                'promptId', 'playerUid', 'playerName', 'status', 'actionCompleted',
                'stageProgressId', 'roll', 'respondedAt', 'presentationReadyAt', 'commandId'
              ]) &&
              request.resource.data.promptId == eventId &&
              request.resource.data.playerUid == responseUid &&
              request.resource.data.playerName is string &&
              request.resource.data.status in ['passed', 'failed', 'declined'] &&
              request.resource.data.actionCompleted is bool &&
              request.resource.data.respondedAt is number &&
              request.resource.data.commandId is string;
          }

          function canReadResponse() {
            let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
            return isRoomCoach(room) || (isRoomMember(room) && responseUid == request.auth.uid);
          }

          // Players can only create their own response. A coach may record a
          // declined response when the disconnected-player recovery path is
          // used; completed financial effects still require the player's own
          // authenticated transaction.
          function canCreateResponse() {
            let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
            return isSharedPromptTarget(room)
              ? validSharedResponse()
              : isFamilyPromptTarget(room)
                ? validFamilyResponse()
                : (isRoomCoach(room) &&
                  sharedPrompt(room) is map &&
                  sharedPrompt(room).id == eventId &&
                  responseUid in sharedPrompt(room).targetPlayerUids &&
                  request.resource.data.status == 'declined' &&
                  validSharedResponse());
          }

          function canUpdateResponse() {
            let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
            return isFamilyPromptTarget(room) &&
              validFamilyResponse() &&
              resource.data.playerUid == responseUid &&
              resource.data.status == 'passed' &&
              resource.data.actionCompleted == false &&
              request.resource.data.actionCompleted == true &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['actionCompleted', 'commandId']);
          }

          allow read: if canReadResponse();
          allow create: if canCreateResponse();
          allow update: if canUpdateResponse();
          allow delete: if false;
        }
      }
    }
    
    // 4. 遊戲記錄規則
    match /score_records/S1/records/{recordId} {
      // 允許玩家讀取包含自己 UID 的記錄，或允許執行師讀取所有記錄
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.playerUids ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
      );
      
      // 只有執行師可以寫入記錄（新增/修改遊戲記錄）
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }
    
    match /room_archives/{sessionId} {
      function coach() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'gm']; }
      allow read: if request.auth != null && (resource.data.hostId == request.auth.uid || coach());
      allow create: if request.auth != null && request.resource.data.sessionId == sessionId &&
        request.resource.data.hostId == request.auth.uid &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid;
      allow update: if request.auth != null && resource.data.hostId == request.auth.uid && request.resource.data.hostId == resource.data.hostId && request.resource.data.roomId == resource.data.roomId;
      allow delete: if coach();
    }

    // 5. 執行師記錄規則
    match /coach_records/{recordId} {
      // 只有執行師可以讀寫
      allow read, write: if request.auth != null && 
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }
    
    // 6. 審計日誌規則
    match /audit_logs/{logId} {
      allow read: if request.auth != null && 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
      allow write: if request.auth != null;
    }
    
    // 7. 排行榜規則
    match /leaderboard/{document=**} {
      // 所有已登入用戶都可以讀取排行榜
      allow read: if request.auth != null;
      
      // 只有 title 為「管理員」的用戶可以寫入（新增/修改/刪除）排行榜
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.title == '管理員';
    }

    // 8. 玩家個人遊戲存檔（自動存檔機制）
    match /player_sessions/{uid}/records/{recordId} {
      // 玩家只能讀寫自己的存檔
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // 執行師可以讀取所有玩家存檔
      allow read: if request.auth != null &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    // 9. 好友系統規則 (解決您的 permission-denied錯誤)
    match /friendships/{friendshipId} {
      // 允許相關人員（請求者或接收者）讀取
      allow read: if request.auth != null && (
        resource.data.requesterId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      
      // 允許創建好友請求（請求者必須是當前用戶）
      allow create: if request.auth != null && request.resource.data.requesterId == request.auth.uid;
      
      // 允許相關人員更新（例如接受請求）或刪除
      allow update, delete: if request.auth != null && (
        resource.data.requesterId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
    }
  }
}
